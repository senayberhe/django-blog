# Copy this file to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. In production, set these in your host's dashboard instead.

# --- Local development ---
DJANGO_DEBUG=1

# --- Production (leave DJANGO_DEBUG unset there) ---
# DJANGO_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_ALLOWED_HOSTS=myblog.com,www.myblog.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://myblog.com,https://www.myblog.com
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Blog identity ---
# BLOG_TITLE=My Blog
# BLOG_DESCRIPTION=Thoughts, notes, and things I'm learning.
# DJANGO_TIME_ZONE=UTC

# --- Uploaded media in S3-compatible storage (e.g. Cloudflare R2) ---
# AWS_STORAGE_BUCKET_NAME=my-blog-media
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.myblog.com
